# TerraSpectra Web Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# API base URL (FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000

# Mapbox GL access token (get one at mapbox.com)
# Leave empty to fall back to MapLibre (open, no token needed)
VITE_MAPBOX_TOKEN=

# Set to "true" to use MSW mock service worker instead of real API
VITE_USE_MOCKS=false

# Basemap: "mapbox" or "maplibre" (maplibre requires no token)
VITE_BASEMAP=maplibre

